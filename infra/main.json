    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the azd environment. Used to name the resource group (rg-<name>) and to derive a unique resource token."
      }
    },
    "location": {
      "type": "string",
      "allowedValues": [
        "eastus2"
      ],
      "metadata": {
        "description": "Primary location for all resources except Azure AI Search. Locked to East US 2 — the only region with every required model deployment and the full Foundry evaluation suite."
      }
    },
    "searchLocation": {
      "type": "string",
      "metadata": {
        "azd": {
          "type": "location"
        },
        "description": "Region for the Azure AI Search service only. Prompted during `azd up`; can differ from the primary region since Search is reached over a global *.search.windows.net endpoint. Pick another region if East US 2 is out of Search capacity."
      },
      "minLength": 1
    }
  },
  "variables": {
    "resourceToken": "[toLower(uniqueString(subscription().id, parameters('environmentName'), parameters('location')))]",
    "tags": {
      "azd-env-name": "[parameters('environmentName')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[format('rg-{0}', parameters('environmentName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "foundry-recipes-resources",
      "resourceGroup": "[format('rg-{0}', parameters('environmentName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "searchLocation": {
            "value": "[parameters('searchLocation')]"
          },
          "resourceToken": {
            "value": "[variables('resourceToken')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "18244713877369170349"
            }
          },
          "parameters": {
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "A short name for the environment, such as dev, test, or prod. This helps you keep deployments organized."
              }
            },
            "location": {
              "type": "string",
              "allowedValues": [
                "eastus2"
              ],
              "metadata": {
                "description": "The Azure region where resources will be deployed. Locked to East US 2: it is the only region where every deployed model (model-router 2025-11-18, gpt-4.1, Phi-4-mini-reasoning, gpt-5.3-codex) AND every Foundry feature the project uses is available — including the full evaluation suite (risk & safety evaluators, Groundedness Pro, and Protected Material, which is East US 2-only)."
              }
            },
            "resourceToken": {
              "type": "string",
              "metadata": {
                "description": "A short unique token used to build globally-unique resource names (Cosmos DB account, Foundry project, Search service). Supplied by main.bicep."
              }
            },
            "sqlDatabaseName": {
              "type": "string",
              "defaultValue": "foundry-recipes",
              "metadata": {
                "description": "The SQL database name inside the Cosmos DB account. This is like a logical database for your app data."
              }
            },
            "containerName": {
              "type": "string",
              "defaultValue": "conversations",
              "metadata": {
                "description": "The container name inside the SQL database. This is where your items will be stored."
              }
            },
            "partitionKeyPath": {
              "type": "string",
              "defaultValue": "/tenantId",
              "metadata": {
                "description": "The partition key path for the container. This is the field Cosmos DB uses to spread data across partitions. Example: /tenantId"
              }
            },
            "throughput": {
              "type": "int",
              "defaultValue": 400,
              "metadata": {
                "description": "The throughput for the container in request units per second (RU/s). A small value like 400 is fine for development."
              }
            },
            "consistencyLevel": {
              "type": "string",
              "defaultValue": "Session",
              "allowedValues": [
                "BoundedStaleness",
                "ConsistentPrefix",
                "Session",
                "Strong",
                "Eventual"
              ],
              "metadata": {
                "description": "The consistency level for the account. Session is a good default for most apps."
              }
            },
            "projectName": {
              "type": "string",
              "defaultValue": "foundry-recipes",
              "metadata": {
                "description": "Foundry Project name - must be globally unique"
              }
            },
            "publicNetworkAccess": {
              "type": "string",
              "defaultValue": "Enabled",
              "metadata": {
                "description": "Project public network access"
              }
            },
            "enableDataIsolation": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Enable data isolation for the project"
              }
            },
            "bingAccountName": {
              "type": "string",
              "defaultValue": "bing-grounding",
              "metadata": {
                "description": "Name for the Grounding with Bing Search account. Must be unique within the resource group."
              }
            },
            "searchServiceName": {
              "type": "string",
              "defaultValue": "foundry-recipes-search",
              "metadata": {
                "description": "Name for the Azure AI Search service. Must be globally unique, 2-60 chars, lowercase letters, digits, and hyphens (no leading/trailing hyphen)."
              }
            },
            "searchServiceSku": {
              "type": "string",
              "defaultValue": "basic",
              "allowedValues": [
                "free",
                "basic",
                "standard"
              ],
              "metadata": {
                "description": "Azure AI Search SKU. Basic is a good default for a demo; free allows only one per subscription."
              }
            },
            "searchIndexName": {
              "type": "string",
              "defaultValue": "knowledge-docs",
              "metadata": {
                "description": "Name of the search index that the knowledge-assistant queries."
              }
            },
            "searchLocation": {
              "type": "string",
              "defaultValue": "[parameters('location')]",
              "metadata": {
                "description": "Region for the Azure AI Search service. Defaults to the main location; override if that region is out of Search capacity."
              }
            }
          },
          "variables": {
            "uniqueSuffix": "[parameters('resourceToken')]",
            "cosmosAccountName": "[format('cosmo-{0}', parameters('resourceToken'))]",
            "projectFullName": "[format('{0}-{1}', parameters('projectName'), variables('uniqueSuffix'))]",
            "demoEnvironment": "demo",
            "modelDeploymentName": "gpt-4-1-nano",
            "modelType": "gpt-4.1-nano",
            "embeddingDeploymentName": "text-embedding-ada-002",
            "embeddingModelType": "text-embedding-ada-002",
            "searchFullName": "[format('{0}-{1}', parameters('searchServiceName'), variables('uniqueSuffix'))]",
            "modelRouterDeploymentName": "model-router",
            "modelRouterModelType": "model-router",
            "modelRouterModelVersion": "2025-11-18",
            "gpt41DeploymentName": "gpt-4.1",
            "gpt41ModelType": "gpt-4.1",
            "gpt41ModelVersion": "2025-04-14",
